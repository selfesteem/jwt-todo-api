# JWT 서명에 사용되는 시크릿입니다. 배포 전 32자 이상의 무작위 문자열로 교체하세요.
# 예: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-value-min-32-chars

# JWT 만료 시간 (jsonwebtoken 문법: 예시 - 30m, 1h, 7d)
JWT_EXPIRES_IN=1h

# SQLite 데이터베이스 파일 경로 (디렉터리가 없으면 자동 생성됨)
DB_PATH=./data/dev.sqlite

# 서버 포트
PORT=3000

# 실행 환경 (development | production). production에서는 synchronize 비활성화
NODE_ENV=development
